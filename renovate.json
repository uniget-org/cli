{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":dependencyDashboard",
    "mergeConfidence:all-badges",
    ":semanticCommits",
    ":disableRateLimiting",
    ":separateMajorReleases",
    ":separatePatchReleases",
    ":automergeRequireAllStatusChecks",
    ":automergeAll",
    ":automergePr",
    ":ignoreModulesAndTests",
    ":docker",
    "docker:enableMajor",
    "docker:pinDigests"
  ],
  "configMigration": true,
  "timezone": "Europe/Berlin",
  "useBaseBranchConfig": "merge",
  "platformAutomerge": true,
  "rebaseWhen": "automerging",
  "major": {
    "labels": [
      "renovate::major",
      "type::renovate"
    ]
  },
  "minor": {
    "labels": [
      "renovate::minor",
      "type::renovate"
    ]
  },
  "patch": {
    "labels": [
      "renovate::patch",
      "type::renovate"
    ]
  },
  "pin": {
    "labels": [
      "renovate::pin",
      "type::renovate"
    ]
  },
  "digest": {
    "labels": [
      "renovate::digest",
      "type::renovate"
    ]
  },
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/(^|/|\\.)Dockerfile[^/]*$/"
      ],
      "matchStrings": [
        "#syntax=(?<depName>.*?):(?<currentValue>.*?)\\n"
      ],
      "datasourceTemplate": "docker",
      "depNameTemplate": "docker/dockerfile"
    }
  ],
  "packageRules": [
    {
      "matchManagers": [
        "gomod"
      ],
      "matchDepTypes": [
        "indirect"
      ],
      "enabled": true
    },
    {
      "matchFileNames": [
        "images/noble/Dockerfile",
        "images/noble-systemd/Dockerfile",
        "images/resolute/Dockerfile",
        "images/resolute-systemd/Dockerfile"
      ],
      "matchDatasource": [
        "docker"
      ],
      "matchPackageNames": [
        "registry.gitlab.com/uniget-org/images/ubuntu",
        "registry.gitlab.com/uniget-org/images/systemd"
      ],
      "matchUpdateTypes": [
        "pin",
        "pinDigest",
        "digest"
      ]
    }
  ],
  "postUpdateOptions": [
    "gomodTidy"
  ]
}
